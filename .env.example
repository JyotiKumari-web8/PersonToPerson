# ==============================================================================
# PersonToPerson Environment Variables
# ==============================================================================

# Public base URL of your application
# In production, set this to your live domain: https://yourdomain.com
# During local development, you can leave it blank to auto-detect current host/network,
# or set it to your network IP (e.g. http://192.168.1.100:5173) for testing phone scans.
VITE_PUBLIC_APP_URL=https://yourdomain.com

# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable Key (from Supabase Dashboard -> Connect / API)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
